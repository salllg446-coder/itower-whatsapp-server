# رابط مشروع Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://iwtvsvfqmafsziqnoekm.supabase.co

# استخدم service_role key (وليس anon key) لأن الخادم يحتاج تجاوز RLS
# ليقرأ/يكتب لكل المستخدمين. هذا المفتاح سري جداً - لا تضعه في أي كود عميل.
SUPABASE_SERVICE_ROLE_KEY=

# كل كم ملي ثانية يفحص الخادم طابور الرسائل الجديدة
QUEUE_POLL_INTERVAL_MS=5000

# المنفذ الذي يستمع عليه خادم /ping (لإبقاء الحاوية مستيقظة على SnapDeploy)
PING_PORT=3000
